# ==============================================================================
# CAPSTONE PATENT & LITERATURE INTELLIGENCE PLATFORM - VARIABLES DE ENTORNO
# ==============================================================================
# Copia este archivo a `.env` para desarrollo local o configura estas claves en
# el panel de Environment Variables de Vercel (Settings -> Environment Variables).
# NUNCA subas credenciales reales al repositorio Git.

# 1. Proveedores de Inteligencia Artificial (Al menos uno recomendado)
GEMINI_API_KEY=tu_clave_de_google_ai_studio_aqui
GROQ_API_KEY=tu_clave_de_groq_cloud_aqui
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# 2. Conectores de Bases de Patentes y Literatura (Opcionales / Respaldo)
SERPAPI_KEY=tu_clave_de_serpapi_opcional
EPO_KEY=tu_consumer_key_de_epo_ops_opcional
EPO_SECRET=tu_consumer_secret_de_epo_ops_opcional
LENS_TOKEN=tu_token_academico_de_the_lens_opcional

# 3. [OPCIONAL - DESACTIVADO EN DEMO PUBLICA] Control de Acceso para Produccion
# Cambia ENABLE_API_AUTH=true y define APP_ACCESS_TOKEN (y opcionalmente ALLOWED_ORIGINS)
# para exigir cabecera `x-access-token` o `Authorization: Bearer <token>` en `/api/*`.
ENABLE_API_AUTH=false
APP_ACCESS_TOKEN=
ALLOWED_ORIGINS=
